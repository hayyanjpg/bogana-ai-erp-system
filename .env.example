APP_ENV=development
TZ=Asia/Jakarta

POSTGRES_DB=bogana
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=dev-internal-token
AI_SERVICE_AUTH_DISABLED=true

# Timeout HTTP dashboard PHP -> FastAPI (detik). Naikkan bila AI service cold start.
AI_SERVICE_TIMEOUT=5

PHP_PORT=8080

# --- Akses dashboard (backend) ---------------------------------------------
# auto (default): wajib login bila kredensial diisi, jika tidak mode demo hanya-baca.
# required | demo | open (open = publik & boleh menulis, khusus lokal)
DASHBOARD_ACCESS_MODE=auto
DASHBOARD_USER=admin
# Buat hash: php -r "echo password_hash('password-anda', PASSWORD_DEFAULT), PHP_EOL;"
DASHBOARD_PASSWORD_HASH=
# Alternatif kurang aman (plaintext) untuk lokal: DASHBOARD_PASSWORD=
# Secret HMAC untuk cookie sesi. Kosongkan untuk fallback turunan password.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL=28800

# -----------------------------------------------------------------------------
# Deploy gratis (Vercel + Neon + Upstash) — lihat docs/DEPLOY_VERCEL.md
# Isi nilai berikut di Vercel Project → Settings → Environment Variables.
#
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/bogana?sslmode=require
# REDIS_URL=rediss://default:password@xxx.upstash.io:6379
# AI_SERVICE_URL=https://bogana-ai-service.vercel.app
# AI_SERVICE_AUTH_DISABLED=false
# -----------------------------------------------------------------------------