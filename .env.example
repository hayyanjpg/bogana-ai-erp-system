APP_ENV=development
TZ=Asia/Jakarta

POSTGRES_DB=bogana
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=dev-internal-token
AI_SERVICE_AUTH_DISABLED=true

# Timeout HTTP dashboard PHP -> FastAPI (detik). Naikkan bila AI service cold start.
AI_SERVICE_TIMEOUT=5

PHP_PORT=8080

# -----------------------------------------------------------------------------
# Deploy gratis (Render + Neon + Upstash) — lihat docs/DEPLOY_RENDER_FREE.md
# Isi nilai berikut di Render Dashboard, bukan di file .env.
#
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/bogana?sslmode=require
# REDIS_URL=rediss://default:password@xxx.upstash.io:6379
# -----------------------------------------------------------------------------